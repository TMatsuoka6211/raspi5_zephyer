+
+	device_map(&pinctrl_base, phys_addr, size, K_MEM_CACHE_NONE);
+
+	uint32_t val = sys_read32(pinctrl_base + 0x08);
+	val &= 0x0000FFFF;
+	val |= 0x11000000; /* Pins 30, 31 = sd2; Pins 28, 29 = GPIO */
