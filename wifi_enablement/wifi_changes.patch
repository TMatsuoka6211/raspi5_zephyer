+	 *   Pin 28: bits 19-16 -> 0 (GPIO)
+	 *   Pin 29: bits 23-20 -> 0 (GPIO)
+	 *   Pin 30: bits 27-24 -> 1 (sd2)
+	 *   Pin 31: bits 31-28 -> 1 (sd2)
+	 *   Value to write: mask out 16-31 and write (1 << 24) | (1 << 28) = 0x11000000
+	 */
+	uint32_t val = sys_read32(pinctrl_base + 0x08);
