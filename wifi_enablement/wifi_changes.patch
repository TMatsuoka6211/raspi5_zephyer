+	val = sys_read32(pinctrl_base + 0x0C);
+	val &= 0xFFFF0000;
+	val |= 0x00001111; /* Pins 32-35 = sd2 */
+	sys_write32(val, pinctrl_base + 0x0C);
+
+	val = sys_read32(pinctrl_base + 0x14);
+	val &= ~0xFFF00000;
+	val |= 0x28000000; /* Pin 31, 32 = Pull-Up, Pin 30 = None */
