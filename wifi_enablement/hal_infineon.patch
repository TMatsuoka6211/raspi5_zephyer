+/* Device data transfer functions */
+whd_result_t whd_bus_sdio_send_buffer(whd_driver_t whd_driver, whd_buffer_t buffer)
+{
+    whd_result_t retval;
+    uint8_t *data_ptr = whd_buffer_get_current_piece_data_pointer(whd_driver, buffer) + sizeof(whd_buffer_header_t);
+    uint16_t data_len = (uint16_t)(whd_buffer_get_current_piece_size(whd_driver, buffer) - sizeof(whd_buffer_header_t));
+
+    uint8_t csr_val = 0;
+    whd_ensure_wlan_bus_is_up(whd_driver);
+    whd_bus_read_register_value(whd_driver, BACKPLANE_FUNCTION, SDIO_CHIP_CLOCK_CSR, 1, &csr_val);
+
+    static uint8_t tx_frame_buf[2048] __attribute__((aligned(64)));
+    uint16_t copy_len = (data_len > sizeof(tx_frame_buf)) ? sizeof(tx_frame_buf) : data_len;
+    uint16_t xfer_len = ROUND_UP(copy_len, 4);
+    memset(tx_frame_buf, 0, ROUND_UP(xfer_len, 64));
+    memcpy(tx_frame_buf, data_ptr, copy_len);
+
+
+
+    retval = whd_bus_sdio_transfer(whd_driver, BUS_WRITE, WLAN_FUNCTION, 0,
+                                   xfer_len, tx_frame_buf, RESPONSE_NEEDED);
+
+
+
+    CHECK_RETURN(whd_buffer_release(whd_driver, buffer, WHD_NETWORK_TX) );
+    if (retval == WHD_SUCCESS)
+    {
+        DELAYED_BUS_RELEASE_SCHEDULE(whd_driver, WHD_TRUE);
+    }
+    CHECK_RETURN (retval);
+
+    return WHD_SUCCESS;
+}
