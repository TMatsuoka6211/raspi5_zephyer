-    }
-    else if (result != WHD_SUCCESS)
-    {
-        whd_assert("Failed to load wifi firmware\n", result == WHD_SUCCESS);
-        return result;
-    }
-
-    CHECK_RETURN(whd_bus_sdio_write_wifi_nvram_image(whd_driver) );
