diff --git a/whd-expansion/WHD/COMMON/src/whd_cdc_bdc.c b/whd-expansion/WHD/COMMON/src/whd_cdc_bdc.c
index fd9477d..6b389b8 100644
--- a/whd-expansion/WHD/COMMON/src/whd_cdc_bdc.c
+++ b/whd-expansion/WHD/COMMON/src/whd_cdc_bdc.c
@@ -235,7 +235,22 @@ whd_result_t whd_cdc_send_ioctl(whd_interface_t ifp, cdc_command_type_t type, ui
 
     /* Prepare the CDC header */
     send_packet->cdc_header.cmd    = htod32(command);
-    send_packet->cdc_header.len    = htod32(data_length);
+
+    /* For WLC_GET_VAR, inlen (upper 16) is iovar name len, outlen (lower 16) is expected response len */
+    if (command == WLC_GET_VAR)
+    {
+        uint32_t iovar_name_len = (uint32_t)strlen((char *)DATA_AFTER_HEADER(send_packet)) + 1;
+        send_packet->cdc_header.len = htod32((iovar_name_len << 16) | (data_length & 0xFFFF));
+        uint16_t send_size = (uint16_t)(sizeof(bus_common_header_t) + sizeof(cdc_header_t) + iovar_name_len);
+        if (whd_buffer_get_current_piece_size(whd_driver, send_buffer_hnd) > send_size)
+        {
+            CHECK_RETURN(whd_buffer_set_size(whd_driver, send_buffer_hnd, send_size));
+        }
+    }
+    else
+    {
+        send_packet->cdc_header.len    = htod32(data_length);
+    }
 
     send_packet->cdc_header.flags  = ( (requested_ioctl_id << CDCF_IOC_ID_SHIFT)
                                        & CDCF_IOC_ID_MASK ) | type | bss_index << CDCF_IOC_IF_SHIFT;
@@ -248,7 +263,7 @@ whd_result_t whd_cdc_send_ioctl(whd_interface_t ifp, cdc_command_type_t type, ui
 
     /* Manufacturing test can receive big buffers, but sending big buffers causes a wlan firmware error */
     /* Even though data portion needs to be truncated, cdc_header should have the actual length of the ioctl packet */
-    if (whd_buffer_get_current_piece_size(whd_driver, send_buffer_hnd) > WHD_IOCTL_MAX_TX_PKT_LEN)
+    if (command != WLC_GET_VAR && whd_buffer_get_current_piece_size(whd_driver, send_buffer_hnd) > WHD_IOCTL_MAX_TX_PKT_LEN)
     {
         CHECK_RETURN(whd_buffer_set_size(whd_driver, send_buffer_hnd, WHD_IOCTL_MAX_TX_PKT_LEN) );
     }
