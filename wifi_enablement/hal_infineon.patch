-#endif
-
-#ifdef BLHS_SUPPORT
-    CHECK_RETURN(whd_bus_common_blhs(whd_driver, CHK_BL_INIT) );
-#endif
-
-#ifndef DM_43022C1
-    result = whd_bus_write_wifi_firmware_image(whd_driver);
-
