+void airoc_boot_log(const char *fmt, ...)
+{
+    va_list args;
+    va_start(args, fmt);
+    if (g_airoc_boot_log_len < sizeof(g_airoc_boot_log) - 128) {
+        int n = vsnprintf(g_airoc_boot_log + g_airoc_boot_log_len,
+                          sizeof(g_airoc_boot_log) - g_airoc_boot_log_len, fmt, args);
+        if (n > 0) {
+            g_airoc_boot_log_len += (size_t)n;
+        }
+    }
+    va_end(args);
+
+    va_start(args, fmt);
+    vprintf(fmt, args);
+    va_end(args);
+    fflush(stdout);
