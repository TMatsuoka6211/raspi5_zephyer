+static whd_result_t whd_bus_sdio_write_wifi_nvram_image(whd_driver_t whd_driver)
+{
+    uint32_t img_base;
+    uint32_t img_end;
+    extern unsigned char wifi_nvram_image_data[];
+    const uint8_t *raw_data = wifi_nvram_image_data;
+    uint32_t raw_size = (uint32_t)NVRAM_IMAGE_SIZE;
+
+    /* Format NVRAM: strip comments, replace newlines with '\0', double '\0' terminate */
+    uint8_t *fmt_buf = whd_mem_malloc(raw_size + 16);
+    if (!fmt_buf) {
+        return WHD_MALLOC_FAILURE;
+    }
+    memset(fmt_buf, 0, raw_size + 16);
+
+    uint32_t out_idx = 0;
+    uint32_t in_idx = 0;
+    while (in_idx < raw_size) {
+        /* Skip leading whitespace / newlines */
+        while (in_idx < raw_size && (raw_data[in_idx] == ' ' || raw_data[in_idx] == '\t' ||
+                                     raw_data[in_idx] == '\r' || raw_data[in_idx] == '\n')) {
+            in_idx++;
+        }
+        if (in_idx >= raw_size) break;
+
+        /* Skip comment lines */
+        if (raw_data[in_idx] == '#' || raw_data[in_idx] == ';') {
+            while (in_idx < raw_size && raw_data[in_idx] != '\n') {
+                in_idx++;
+            }
+            continue;
+        }
+
+        /* Copy line until newline */
+        uint32_t line_start = out_idx;
+        while (in_idx < raw_size && raw_data[in_idx] != '\r' && raw_data[in_idx] != '\n') {
+            fmt_buf[out_idx++] = raw_data[in_idx++];
+        }
+        /* Null-terminate this key=value entry */
+        if (out_idx > line_start) {
+            fmt_buf[out_idx++] = '\0';
+        }
+    }
+    /* Double null termination */
+    fmt_buf[out_idx++] = '\0';
+    fmt_buf[out_idx++] = '\0';
+
+    /* Round up to 4 bytes */
+    uint32_t image_size = ROUND_UP(out_idx, 4);
+
+    uint32_t memsize = GET_C_VAR(whd_driver, CHIP_RAM_SIZE);
+    uint32_t atcm_base = GET_C_VAR(whd_driver, ATCM_RAM_BASE_ADDRESS);
+
+    /* NVRAM is placed immediately before the 4-byte token at the top of RAM */
+    img_end = atcm_base + memsize - 4;
+    img_base = atcm_base + memsize - (image_size + 4);
+
+    uint32_t token = ((~((uint32_t)image_size / 4) & 0xFFFF) << 16) | ((uint32_t)image_size / 4);
+    airoc_boot_log("AIROC: Formatted NVRAM raw_size=%d -> image_size=%d, img_base=0x%08x, img_end=0x%08x, token=0x%08x\n",
+                   raw_size, image_size, img_base, img_end, token);
+
+    /* Transfer formatted NVRAM to backplane via reliable 4-byte writes */
+    whd_result_t result = WHD_SUCCESS;
+    for (uint32_t off = 0; off < image_size; off += 4) {
+        uint32_t val = *(uint32_t *)(fmt_buf + off);
+        result = whd_bus_write_backplane_value(whd_driver, img_base + off, 4, val);
+        if (result != WHD_SUCCESS) {
+            printf("AIROC Error: NVRAM write at 0x%08x failed: 0x%08x\n", img_base + off, result);
+            fflush(stdout);
+            whd_mem_free(fmt_buf);
+            return result;
+        }
+    }
+    whd_mem_free(fmt_buf);
+
+    /* Write NVRAM size token at the end of RAM */
+    CHECK_RETURN(whd_bus_write_backplane_value(whd_driver, (uint32_t)img_end, 4, token) );
+    uint32_t token_rb = 0;
+    whd_bus_read_backplane_value(whd_driver, (uint32_t)img_end, 4, (uint8_t *)&token_rb);
+    airoc_boot_log("AIROC: NVRAM token @0x%08x readback=0x%08x\n", img_end, token_rb);
+
+#ifdef BLHS_SUPPORT
+    CHECK_RETURN(whd_bus_common_blhs(whd_driver, POST_NVRAM_DOWNLOAD) );
+#endif /* BLHS_SUPPORT */
+
+    return WHD_SUCCESS;
+}
