+/*
+ * Release ARM core to run instructions
+ */
+whd_result_t whd_wlan_armcore_run(whd_driver_t whd_driver, device_core_t core_id, wlan_core_flag_t core_flag)
+{
+    uint32_t base = whd_get_core_address(whd_driver, core_id);
+    whd_result_t result;
+    uint32_t junk;
+
+    /* Only work for WLAN arm core! */
+    if (WLAN_ARM_CORE != core_id)
+    {
+        return WHD_UNSUPPORTED;
+    }
+
+    uint32_t ioctrl_val = (SICF_FGC | SICF_CLOCK_EN | ((core_flag == WLAN_CORE_FLAG_CPU_HALT) ? SICF_CPUHALT : 0));
+    result = whd_bus_write_backplane_value(whd_driver, base + AI_IOCTRL_OFFSET, 4, ioctrl_val);
+    if (result != WHD_SUCCESS)
+    {
+        WPRINT_WHD_ERROR( ("%s:%d whd_bus_write_backplane_value failed\n", __FUNCTION__, __LINE__) );
+        return result;
+    }
+
+    result = whd_bus_read_backplane_value(whd_driver, base + AI_IOCTRL_OFFSET, 4, (uint8_t *)&junk);
+    if (result != WHD_SUCCESS)
+    {
+        WPRINT_WHD_ERROR( ("%s:%d whd_bus_read_backplane_value failed\n", __FUNCTION__, __LINE__) );
+        return result;
+    }
+
+    result = whd_bus_write_backplane_value(whd_driver, base + AI_RESETCTRL_OFFSET, 4, 0);
+    if (result != WHD_SUCCESS)
+    {
+        WPRINT_WHD_ERROR( ("%s:%d whd_bus_write_backplane_value failed\n", __FUNCTION__, __LINE__) );
+        return result;
+    }
+
+    (void)cy_rtos_delay_milliseconds( (uint32_t)1 );
+
+    uint32_t final_ioctrl = (SICF_CLOCK_EN | ((core_flag == WLAN_CORE_FLAG_CPU_HALT) ? SICF_CPUHALT : 0));
+    result = whd_bus_write_backplane_value(whd_driver, base + AI_IOCTRL_OFFSET, 4, final_ioctrl);
+    if (result != WHD_SUCCESS)
+    {
+        WPRINT_WHD_ERROR( ("%s:%d whd_bus_write_backplane_value failed\n", __FUNCTION__, __LINE__) );
+        return result;
+    }
+
+    uint32_t rst_check = 0, io_check = 0;
+    whd_bus_read_backplane_value(whd_driver, base + AI_RESETCTRL_OFFSET, 4, (uint8_t *)&rst_check);
+    whd_bus_read_backplane_value(whd_driver, base + AI_IOCTRL_OFFSET, 4, (uint8_t *)&io_check);
+    printf("AIROC: whd_wlan_armcore_run verified: RESETCTRL=0x%08x IOCTRL=0x%08x (res=0x%x)\n",
+           rst_check, io_check, result);
+    fflush(stdout);
+
+    (void)cy_rtos_delay_milliseconds( (uint32_t)1 );
+
+    return result;
+}
