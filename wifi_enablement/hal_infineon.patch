-        if (result == WHD_SUCCESS)
-        {
-            timeout_ms = CY_RTOS_NEVER_TIMEOUT;
-        }
-    }
-
-    /* Check if we have run out of bus credits */
-    if ( (whd_sdpcm_has_tx_packet(whd_driver) == WHD_TRUE) && (whd_sdpcm_get_available_credits(whd_driver) == 0) )
