+/*
+ * Resets the core identified by the provided coreId
+ */
+whd_result_t whd_reset_core(whd_driver_t whd_driver, device_core_t core_id, uint32_t bits, uint32_t resetbits)
+{
+    uint32_t base = whd_get_core_address(whd_driver, core_id);
+    whd_result_t result;
+    uint32_t rst_ctrl = 0, io_ctrl = 0;
+
+    printf("AIROC: whd_reset_core: core_id=%d base=0x%08x bits=0x%x resetbits=0x%x\n",
+           core_id, base, bits, resetbits);
+    fflush(stdout);
+
+    /* put core into reset state */
+    result = whd_bus_write_backplane_value(whd_driver, base + AI_RESETCTRL_OFFSET, (uint8_t)4, (uint32_t)AIRC_RESET);
+    (void)cy_rtos_delay_milliseconds( (uint32_t)10 );
+
+    result = whd_bus_write_backplane_value(whd_driver, base + AI_IOCTRL_OFFSET, (uint8_t)4,
+                                           (bits | resetbits | SICF_FGC | SICF_CLOCK_EN) );
+    (void)cy_rtos_delay_milliseconds( (uint32_t)10 );
+
+    /* take core out of reset */
+    result = whd_bus_write_backplane_value(whd_driver, base + AI_RESETCTRL_OFFSET, (uint8_t)4, (uint32_t)0);
+    (void)cy_rtos_delay_milliseconds( (uint32_t)10 );
+
+    result = whd_bus_write_backplane_value(whd_driver, base + AI_IOCTRL_OFFSET, (uint8_t)4, (bits | SICF_CLOCK_EN) );
+    (void)cy_rtos_delay_milliseconds( (uint32_t)10 );
+
+    /* verify reset and io control registers */
+    whd_bus_read_backplane_value(whd_driver, base + AI_RESETCTRL_OFFSET, (uint8_t)4, (uint8_t *)&rst_ctrl);
+    whd_bus_read_backplane_value(whd_driver, base + AI_IOCTRL_OFFSET, (uint8_t)4, (uint8_t *)&io_ctrl);
+    printf("AIROC: whd_reset_core verified: RESETCTRL=0x%08x IOCTRL=0x%08x (res=0x%x)\n",
+           rst_ctrl, io_ctrl, result);
+    fflush(stdout);
+
+    return result;
+}
